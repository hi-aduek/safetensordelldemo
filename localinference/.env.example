# Hosted DeepSeek V4 Flash API; weights are served remotely and are not downloaded here.
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=replace-me

# Existing OpenAI-compatible Whisper transcription service.
# Example: http://localhost:9000/v1. No Whisper model is downloaded by this harness.
WHISPER_BASE_URL=http://localhost:9000/v1
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=

# Optional existing Fieldview backend. Requests beginning map:, geo:, or geospatial: use it.
MAP_API_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8010
