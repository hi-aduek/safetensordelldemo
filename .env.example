# Optional Cesium ion token: enables World Terrain and private/public ion assets.
VITE_CESIUM_ION_TOKEN=

# OpenAI-compatible endpoint running locally on the GB10.
# Example: vLLM, NVIDIA NIM, or another compatible local server.
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=your-local-model-id
LOCAL_LLM_API_KEY=local-demo
